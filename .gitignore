# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── IDE and editors ──────────────────────────────────────────────────────────
.idea/
.vscode/

# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Environment files ─────────────────────────────────────────────────────────
# Keep .env.example files, ignore everything else
.env
.env.*
!.env.example

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
venv/
.venv/

# ── Build outputs ─────────────────────────────────────────────────────────────
/build
dist/
frontend/dist/
*.tsbuildinfo
.next/
/out/
next-env.d.ts

# ── Testing ───────────────────────────────────────────────────────────────────
/coverage
test_reports/

# ── Logs ─────────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb

# ── System ───────────────────────────────────────────────────────────────────
.DS_Store
*.pem
Thumbs.db

# ── Archives and large binaries ───────────────────────────────────────────────
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib

# ── Build caches ──────────────────────────────────────────────────────────────
.cache/
.expo/
.metro-cache/

# ── Mobile ───────────────────────────────────────────────────────────────────
android-sdk/

# ── Credentials ───────────────────────────────────────────────────────────────
*token.json*
*credentials.json*

# ── Deployment ────────────────────────────────────────────────────────────────
.vercel
-e 
# Environment files
*.env
*.env.*
