# Production env for Railway — copy to deploy.env (gitignored) and fill in.
# Script can sync these via: railway variables set KEY=VALUE (when using --cli)
# Or set manually in Railway dashboard → Variables.

MONGO_URL=mongodb+srv://USER:PASSWORD@cluster0.XXXXX.mongodb.net/?appName=Cluster0
DB_NAME=rainstorms_db
JWT_SECRET=GENERATE_WITH_python3_-c_import_secrets_print_secrets.token_hex_32
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_key
