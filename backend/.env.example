# ── Rainstorms Backend — Environment Variables ──────────────────────────────
# Copy this file to backend/.env and fill in your values.
# Never commit the real .env file.

# MongoDB connection string (required)
# Local dev:  MONGO_URL=mongodb://localhost:27017
#   brew tap mongodb/brew && brew install mongodb-community && brew services start mongodb-community
# Atlas/Railway: MONGO_URL=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net
MONGO_URL=mongodb://localhost:27017

# MongoDB database name (optional, defaults to rainstorms_db)
DB_NAME=rainstorms_db

# JWT secret — change this to a long random string in production
JWT_SECRET=change_me_to_a_long_random_secret

# ── AI / LLM provider ────────────────────────────────────────────────────────
# Choose which LLM provider to use for story & lore generation.
# Accepted values: "openai" (default), "gemini", or "groq"
# Groq has a free tier (no card): https://console.groq.com
LLM_PROVIDER=groq

# OpenAI API key
# Used for:
#   • Text generation (GPT-4.1) when LLM_PROVIDER=openai
#   • Image generation (DALL-E 3) regardless of LLM_PROVIDER
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API key
# Used for text generation (gemini-2.0-flash) when LLM_PROVIDER=gemini
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API key (free tier, no card needed)
# Get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# SagaArchitect / MythLoreBuilder base URL
# When set, Rainstorms fetches the universe list and story-context directly from
# SagaArchitect instead of requiring a prior sync into the local database.
# Example: SAGA_ARCHITECT_BASE_URL=https://saga.preview.emergentagent.com
SAGA_ARCHITECT_BASE_URL=
