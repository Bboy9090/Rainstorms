# ── Rainstorms Backend — Environment Variables ──────────────────────────────
# Copy this file to backend/.env and fill in your values.
# Never commit the real .env file.

# MongoDB connection string (required)
# Local:      MONGO_URL=mongodb://localhost:27017
# Atlas free: MONGO_URL=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net
MONGO_URL=mongodb://localhost:27017

# MongoDB database name (optional, defaults to rainstorms_db)
DB_NAME=rainstorms_db

# JWT secret — change this to a long random string in production
JWT_SECRET=change_me_to_a_long_random_secret

# Emergent LLM API key — powers the AI story generation
# Get one at https://emergentintegrations.com
EMERGENT_LLM_KEY=your_emergent_api_key_here

# OpenAI API key — powers the Illustration System (DALL-E 3 image generation)
# If not set, EMERGENT_LLM_KEY is used as a fallback when it is also an OpenAI key.
# Without a valid key the illustration generation endpoints will return 503.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# SagaArchitect / MythLoreBuilder base URL
# When set, Rainstorms fetches the universe list and story-context directly from
# SagaArchitect instead of requiring a prior sync into the local database.
# Example: SAGA_ARCHITECT_BASE_URL=https://saga.preview.emergentagent.com
SAGA_ARCHITECT_BASE_URL=
