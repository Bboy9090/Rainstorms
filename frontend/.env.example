# ── Rainstorms Frontend — Environment Variables ─────────────────────────────
# Copy this file to frontend/.env and fill in your values.
# Never commit the real .env file.

# Backend API URL (no trailing slash)
# Local dev:  EXPO_PUBLIC_BACKEND_URL=http://localhost:8001
# Production: EXPO_PUBLIC_BACKEND_URL=https://api.yourdomain.com
EXPO_PUBLIC_BACKEND_URL=http://localhost:8001
